# ==============================================================================
# Hermes Agent - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Integration (Required for telegram_hermes.py)
# ------------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram (e.g., 123456789:ABCdefGhIJKlmNoPQRstuVWxYZ)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# STRICT AUTHORIZATION:
# Only allow specific numerical Telegram user IDs to talk to the agent.
# Find your ID by messaging @userinfobot on Telegram.
# Multiple IDs can be comma-separated: 123456789,987654321
TELEGRAM_ALLOWED_USER_ID=YOUR_TELEGRAM_USER_ID

# ------------------------------------------------------------------------------
# 2. LLM Provider & Model Selection
# ------------------------------------------------------------------------------
# Default model to use (OpenRouter format: provider/model or bare model name)
# Examples:
#   anthropic/claude-sonnet-4.6
#   openai/gpt-4o
#   meta-llama/llama-3.3-70b-instruct
#   openrouter/auto
HERMES_MODEL=openrouter/auto

# Preferred provider: openrouter | openai | anthropic | custom | auto
HERMES_PROVIDER=openrouter

# Custom API base URL (optional, for local LLMs e.g. Ollama, LMStudio, vLLM)
# HERMES_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 3. LLM Provider API Keys (Set at least one)
# ------------------------------------------------------------------------------
# OpenRouter (Recommended: access to 300+ models with one key)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 4. Cloudflare Tunnel (Zero Trust Outbound Tunnel)
# ------------------------------------------------------------------------------
# Token provided by Cloudflare Zero Trust Dashboard (Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ------------------------------------------------------------------------------
# 5. Optional Search & Tool Gateway API Keys
# ------------------------------------------------------------------------------
# Exa AI search
# EXA_API_KEY=
# Brave Search
# BRAVE_API_KEY=
# Tavily Search
# TAVILY_API_KEY=
# Firecrawl Web Scraper
# FIRECRAWL_API_KEY=
