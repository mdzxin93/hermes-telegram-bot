# Dockerfile for Hermes Agent Telegram Bot
FROM python:3.12-slim-bookworm

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ffmpeg \
    ripgrep \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY . /app

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install -e . || pip install openai python-dotenv "python-telegram-bot>=21.0,<22" httpx rich requests pydantic qrcode

EXPOSE 8080

# Run Telegram bot wrapper
CMD ["python", "telegram_hermes.py"]
